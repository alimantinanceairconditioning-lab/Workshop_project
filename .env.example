# MongoDB Configuration
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# JWT Secret for Authentication
# Generate a random secret: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Next.js Public URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Cloudinary Configuration
# Sign up at: https://cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend Email Configuration
# Get your API key from: https://resend.com/api-keys
# Note: With free plan, emails can only be sent to verified email addresses
# Verify your email at: https://resend.com/emails
RESEND_API_KEY=re_your_resend_api_key
ADMIN_EMAIL=your-email@example.com
